# ==============================================================================
# BIMA DOST — ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================
# Copy this file to .env for local development, or configure these variables
# in the Vercel Project Settings > Environment Variables for production.

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL)
# ------------------------------------------------------------------------------
# In Vercel, this is automatically configured when connecting a Postgres (Neon) integration,
# or provide your hosted PostgreSQL connection string (Neon, Supabase, AWS RDS, etc.).
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=require
DATABASE_URL="postgresql://username:password@ep-example.region.aws.neon.tech/bimadost?sslmode=require"

# Optional: Maximum pool connections per serverless container (default: 10)
PG_POOL_MAX="10"

# ------------------------------------------------------------------------------
# 2. APPLICATION RUNTIME & SECURITY
# ------------------------------------------------------------------------------
# Deployment public URL (e.g. https://bimadost.vercel.app or custom domain)
APP_URL="https://bimadost.in"
PORT="3000"

# Secret key used to sign and verify administrative JWT session tokens.
# REQUIRED in production. Generate a strong 64-character random string.
JWT_SECRET="generate-a-strong-random-secret-key-here"

# ------------------------------------------------------------------------------
# 3. INITIAL ADMINISTRATOR ACCOUNT (Seeded on first startup if no admin exists)
# ------------------------------------------------------------------------------
# In production, provide explicit secure credentials for the root administrator.
ADMIN_INITIAL_EMAIL="admin@bimadost.in"
ADMIN_INITIAL_PASSWORD="ChangeThisToAStrongUniquePassword@2026"

# ------------------------------------------------------------------------------
# 4. RAZORPAY PAYMENT GATEWAY (Indian Rupee INR Processing)
# ------------------------------------------------------------------------------
# Obtain from Razorpay Dashboard > Settings > API Keys
# Test keys start with 'rzp_test_', Production keys start with 'rzp_live_'
RAZORPAY_KEY_ID="rzp_test_YourKeyId"
RAZORPAY_KEY_SECRET="YourRazorpayKeySecret"

# Webhook Secret configured in Razorpay Dashboard > Webhooks
# Used for HMAC-SHA256 signature verification against raw request bodies
RAZORPAY_WEBHOOK_SECRET="YourRazorpayWebhookSecret"

# ------------------------------------------------------------------------------
# 5. RESEND TRANSACTIONAL EMAIL PROVIDER
# ------------------------------------------------------------------------------
# Obtain from https://resend.com/api-keys
RESEND_API_KEY="re_YourResendApiKey"
EMAIL_FROM="Bima Dost Consultations <onboarding@resend.dev>"
ADMIN_NOTIFICATION_EMAIL="admin@bimadost.in"

# ------------------------------------------------------------------------------
# 6. GOOGLE CALENDAR & GOOGLE MEET INTEGRATION
# ------------------------------------------------------------------------------
# Google Cloud Service Account credentials for automated event & Meet link generation
GOOGLE_SERVICE_ACCOUNT_EMAIL="bima-dost-organizer@your-gcp-project.iam.gserviceaccount.com"
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYourPrivateKeyHere\n-----END PRIVATE KEY-----\n"
GOOGLE_CALENDAR_ID="primary"

# ------------------------------------------------------------------------------
# 7. GEMINI MULTILINGUAL AI GRIEVANCE CHATBOT
# ------------------------------------------------------------------------------
# Google Gemini API Key for civic insurance counseling
GEMINI_API_KEY="AIzaSyYourGeminiApiKey"

# ------------------------------------------------------------------------------
# 8. WHATSAPP CLOUD API (Optional - Meta Graph API v21.0)
# ------------------------------------------------------------------------------
# If omitted or unconfigured, the system gracefully marks WhatsApp status as 'skipped'
WHATSAPP_PHONE_NUMBER_ID="YourWhatsAppPhoneNumberId"
WHATSAPP_ACCESS_TOKEN="YourWhatsAppCloudApiSystemUserToken"
