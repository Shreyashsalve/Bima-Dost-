# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# RAZORPAY CONFIGURATION (Indian Payment Gateway)
# Obtain these from https://dashboard.razorpay.com/#/app/keys
# In test mode, keys start with rzp_test_...
RAZORPAY_KEY_ID="rzp_test_YourRazorpayKeyId"
RAZORPAY_KEY_SECRET="YourRazorpayKeySecret"

# JWT AUTHENTICATION
# Secure secret used to sign and verify administrator JSON Web Tokens
JWT_SECRET="bimadost_production_jwt_secret_change_in_production"

# INITIAL ADMIN CREDENTIALS (Seeded on first startup if not already in database)
ADMIN_INITIAL_EMAIL="admin@bimadost.in"
ADMIN_INITIAL_PASSWORD="AdminPassword@2026"

# RAZORPAY WEBHOOK SECRET (For signed webhook HMAC SHA256 verification)
RAZORPAY_WEBHOOK_SECRET="YourRazorpayWebhookSecret"

# WHATSAPP BUSINESS PLATFORM CLOUD API (Official Meta Graph API v21.0)
# Obtain from Meta for Developers > WhatsApp > API Setup
WHATSAPP_PHONE_NUMBER_ID="YourWhatsAppPhoneNumberId"
WHATSAPP_ACCESS_TOKEN="YourWhatsAppCloudApiSystemUserToken"

# RESEND TRANSACTIONAL EMAIL PROVIDER
# Obtain from https://resend.com/api-keys
RESEND_API_KEY="re_YourResendApiKey"
EMAIL_FROM="Bima Dost Consultations <onboarding@resend.dev>"
ADMIN_NOTIFICATION_EMAIL="admin@bimadost.in"

# GOOGLE CALENDAR & GOOGLE MEET INTEGRATION
# Method 1: Google Cloud Service Account (recommended for server-side event creation)
GOOGLE_SERVICE_ACCOUNT_EMAIL="bima-dost-organizer@your-gcp-project.iam.gserviceaccount.com"
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYourPrivateKey\n-----END PRIVATE KEY-----\n"
GOOGLE_CALENDAR_ID="primary"

# Method 2 (Alternative): Direct OAuth Access Token
# GOOGLE_CALENDAR_ACCESS_TOKEN="ya29.YourGoogleCalendarAccessToken"
